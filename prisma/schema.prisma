// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  initials    String  @db.Char(2)
  description String?

  imageUrl String?

  latitude  Float?
  longitude Float?

  // IANA timezone identifier (e.g. "Asia/Manila", "America/Los_Angeles").
  // Drives display-time formatting on the customer booking surface.
  // NOTE: server-side date math throughout the app is currently
  // PH-locked via lib/date-utils.ts — broader timezone awareness is a
  // separate refactor. This field is the storage shape that unblocks it.
  timezone                           String            @default("Asia/Manila")
  booking_horizon_days               Int               @default(14)
  booking_min_lead_minutes           Int               @default(30)
  booking_slot_interval_minutes      Int               @default(30)
  public_allow_full_payment          Boolean           @default(true)
  public_allow_downpayment           Boolean           @default(true)
  public_default_payment_type        String            @default("FULL")
  downpayment_percentage             Int               @default(50)
  booking_v2_enabled                 Boolean           @default(true)
  same_day_attendance_strict_minutes Int               @default(120)
  // Optional formal weekly shift model. When false (default) the
  // existing recurring_days_off + business hours behavior applies —
  // this matches the small-shop case. When true, employees with
  // EmployeeSchedule rows are constrained by them; employees with no
  // schedule rows fall back to the default behavior so flipping the
  // flag doesn't accidentally hide every employee at once.
  formal_schedule_enabled            Boolean           @default(false)
  structure                          BusinessStructure @default(OWNER_EMPLOYEE_SELF_SERVICE)
  allow_employee_self_booking        Boolean           @default(true)
  manager_can_serve                  Boolean           @default(true)
  gcash_account_name                 String?
  gcash_mobile_number                String?
  gcash_qr_image_url                 String?
  gcash_instructions                 String?

  services                          Service[]
  employees                         Employee[]
  owners                            Owner[]
  customers                         Customer[]
  bookings                          Booking[]
  sale_events                       SaleEvent[]
  social_connections                SocialConnection[]
  social_posts                      SocialPost[]
  social_post_requests              SocialPostRequest[]
  messaging_channels                MessengerChannel[]
  messaging_settings                CustomerMessagingSettings?
  vouchers                          Voucher[]
  gift_cards                        GiftCard[]
  special_dates                     SpecialDate[]
  packages                          ServicePackage[]
  leave_requests                    LeaveRequest[]
  business_hours                    BusinessHours[]
  service_flows                     ServiceFlow[]
  brand_assets                      BrandAsset[]
  reference_candidates              ReferenceCandidate[]
  growth_settings                   BusinessGrowthSettings?
  growth_context_snapshots          GrowthContextSnapshot[]
  opportunities                     Opportunity[]
  campaigns                         Campaign[]
  subscriptions                     BusinessSubscription[]
  subscription_upgrade_requests     SubscriptionPlanUpgradeRequest[]
  subscription_invoices             SubscriptionInvoice[]
  referral_code                     ReferralCode?
  referral_leads_converted          ReferralLead[]                   @relation("ConvertedBusinessReferralLead")
  referral_attributions_as_referrer ReferralAttribution[]            @relation("ReferrerBusiness")
  referral_attributions_as_referred ReferralAttribution[]            @relation("ReferredBusiness")
  onboarding_applications_converted OnboardingApplication[]          @relation("ConvertedBusinessOnboardingApplication")
  platform_action_logs              PlatformActionLog[]
  commission_calculation_basis      CommissionCalculationBasis       @default(ORIGINAL_PRICE)
  booking_otp_codes                 BookingOtpCode[]
  expenses                          Expense[]
  payroll_settings                  PayrollSettings?
  payroll_runs                      PayrollRun[]
  service_charge_pools              PayrollServiceChargePool[]
  payroll_commands                  PayrollCommand[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([slug])
}

/**
 * model LeaveRequest {
 * id Int @id @default(autoincrement())
 * employee_id Int
 * employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
 * business_id String
 * business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
 * start_date DateTime
 * end_date DateTime
 * reason String
 * status LeaveRequestStatus @default(PENDING)
 * admin_comment String?
 * created_at DateTime @default(now())
 * updated_at DateTime @updatedAt
 * }
 */

enum Role {
  OWNER
  EMPLOYEE
  PLATFORM_ADMIN
}

enum BusinessStructure {
  OWNER_EMPLOYEE_SELF_SERVICE
  MANAGER_LED
  CASHIER_LED
  MANAGER_CASHIER
}

enum StaffProfile {
  STAFF
  MANAGER
  CASHIER
}

enum StaffPermission {
  BOOKING_CREATE
  PAYMENT_COLLECT
  PAYMENT_VERIFY
  QUEUE_CLAIM_SELF
  QUEUE_SERVE_SELF
  QUEUE_OVERRIDE_ALL
  CATALOG_MANAGE
  // Booking-editor (Phase 1) — see docs/role-permissions-matrix.md
  BOOKING_MODIFY
  BOOKING_MARK_NO_SHOW
  BOOKING_ADJUST_PRICE
  BOOKING_CANCEL
  // Social-post-request — see docs/social-post-request-design.md
  SOCIAL_POST_REQUEST_CREATE
  SOCIAL_POST_REVIEW
  SOCIAL_POST_PUBLISH
}

// Categorizes uploaded brand imagery so the same library can power
// logo watermarking, hero photos, AI reference images, and per-entity
// thumbnails without a separate column on every owning model. The
// kind drives which screens render the asset.
enum BrandAssetKind {
  LOGO
  HERO
  SERVICE
  EMPLOYEE
  REFERENCE
}

// Classifies what a reference image actually depicts so the social-post
// image generator can adapt its prompt. PERSON triggers strict identity-
// preservation rules (preserve face, skin tone, age, hairstyle); the rest
// feed the model visual direction only. Nullable on BrandAsset — only
// meaningful for kind=REFERENCE rows.
enum ReferenceSubject {
  PERSON
  BRAND
  PRODUCT
  STYLE
}

// Per-owner capabilities. Single-owner businesses default to the full
// set so existing behavior is preserved. Co-owners can be granted a
// restricted subset (e.g. sales-only) by clearing chips on the owner
// permissions editor.
enum OwnerPermission {
  BILLING_VIEW
  BILLING_MANAGE
  REPORTS_VIEW_FULL
  REPORTS_VIEW_SALES_ONLY
  EMPLOYEES_MANAGE
  STAFF_MANAGE
  SETTINGS_MANAGE
  CATALOG_MANAGE
  PAYROLL_MANAGE
  WORKFORCE_MANAGE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
  CANCELED
}

enum SubscriptionUpgradeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  FAILED
  EXPIRED
}

enum CreditSource {
  TRIAL_GRANT
  REFERRAL_REWARD
  ADMIN_ADJUSTMENT
  MANUAL_COMP
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  REJECTED
}

enum OnboardingApplicationStatus {
  NEW
  CONTACTED
  APPROVED
  REJECTED
  CONVERTED
}

enum VoucherType {
  PERCENTAGE
  FLAT
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum SocialPlatform {
  FACEBOOK_PAGE
  INSTAGRAM_BUSINESS
}

enum SocialConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum SocialPostSource {
  SALE_EVENT
  MANUAL
}

enum SocialPostStatus {
  DRAFT
  READY
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum SocialTargetStatus {
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  SKIPPED
}

enum BookingStatus {
  HOLD // Slot reserved during payment
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum PayslipStatus {
  PENDING
  PAID
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  OFF
  LEAVE
}

enum PaymentMethod {
  CASH
  ONLINE
  GCASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum BookingPaymentType {
  FULL
  DOWNPAYMENT
  BALANCE
  MANUAL
}

enum BookingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELED
}

enum AvailedServiceStatus {
  PENDING // No employee claimed yet
  CLAIMED // Employee claimed, not yet served
  SERVING // Currently being served
  COMPLETED // Service finished
  CANCELLED // Service cancelled
}

enum ServiceProviderType {
  EMPLOYEE
  OWNER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  VACATION
  SICK
  EMERGENCY
  OTHER
}

model LeaveRequest {
  id Int @id @default(autoincrement())

  employee_id Int
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  business_id String
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  start_date    DateTime
  end_date      DateTime
  reason        String
  type          LeaveType          @default(VACATION)
  status        LeaveRequestStatus @default(PENDING)
  admin_comment String?
  is_paid       Boolean            @default(false)
  revision      Int                @default(0)
  cancelled_at  DateTime?
  benefit_code  String             @default("DISCRETIONARY")
  allocations   LeaveAllocation[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([business_id, created_at])
  @@index([employee_id, created_at])
  @@index([employee_id, start_date, end_date])
}

model BusinessHours {
  id          Int     @id @default(autoincrement())
  day_of_week Int
  open_time   String // "09:00" (24hr format)
  close_time  String // "18:00"
  is_closed   Boolean @default(false)

  category String @default("GENERAL") // "GENERAL", "Spa", "Nails", etc.

  business_id String
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([business_id, day_of_week, category])
}

model SaleEvent {
  id Int @id @default(autoincrement())
  revision Int @default(0)
  conditional_rule Json?
  applications BookingOfferApplication[]

  title       String
  description String?

  start_date DateTime
  end_date   DateTime

  discount_type  DiscountType @default(PERCENTAGE)
  discount_value Float        @default(0)
  slot_limit     Int?

  applicable_services Service[]
  applicable_packages ServicePackage[]

  business_id      String
  business         Business     @relation(fields: [business_id], references: [id], onDelete: Cascade)
  bookings         Booking[]
  social_posts     SocialPost[]
  growth_campaigns Campaign[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([business_id, created_at])
  @@index([business_id, start_date, end_date])
}

model SocialConnection {
  id                  String         @id @default(cuid())
  business_id         String
  business            Business       @relation(fields: [business_id], references: [id], onDelete: Cascade)
  platform            SocialPlatform
  external_account_id String
  display_name        String
  username            String?

  access_token_encrypted String
  token_expires_at       DateTime?
  scopes                 String[]               @default([])
  status                 SocialConnectionStatus @default(CONNECTED)
  last_sync_at           DateTime?

  targets SocialPostTarget[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([business_id, platform])
  @@index([business_id, status])
}

enum CustomerMessagingMode {
  OFF
  SUGGEST
  AUTO
}

enum CustomerMessagingLanguage {
  EN
  FIL
  TAGLISH
  UNKNOWN
}

enum CustomerMessageDirection {
  INBOUND
  OUTBOUND
}

enum CustomerMessagingJobStatus {
  PENDING
  CLAIMED
  SUGGESTED
  SENDING
  CONFIRMED
  FAILED
  UNKNOWN
  CANCELLED
}

// Dedicated messaging evidence. Publishing SocialConnection is never consulted.
// No production setup writer exists until provider verification is reviewed.
model MessengerChannel {
  id                      String   @id @default(cuid())
  business_id             String
  business                Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  app_id                  String
  page_id                 String
  display_name            String
  token_encrypted         String
  token_expires_at        DateTime?
  revision                Int      @default(0)
  active                  Boolean  @default(false)
  verified_at             DateTime?
  permissions_verified_at DateTime?
  pages_messaging_granted Boolean  @default(false)
  facebook_login_verified Boolean  @default(false)
  app_review_verified     Boolean  @default(false)
  business_verified       Boolean  @default(false)
  page_message_task       Boolean  @default(false)
  webhook_subscribed      Boolean  @default(false)
  echoes_verified         Boolean  @default(false)
  metadata_echo_verified  Boolean  @default(false)
  pilot_approved          Boolean  @default(false)
  conversations           CustomerConversation[]
  receipts                CustomerMessagingReceipt[]
  suppressions            CustomerMessagingSuppression[]
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  @@unique([app_id, page_id])
  @@unique([business_id, id])
  @@index([business_id, active])
}

model CustomerMessagingSettings {
  business_id      String                    @id
  business         Business                  @relation(fields: [business_id], references: [id], onDelete: Cascade)
  mode             CustomerMessagingMode     @default(OFF)
  consent          Boolean                   @default(false)
  ai_consent       Boolean                   @default(false)
  consenting_user_id String?
  paused           Boolean                   @default(false)
  default_language CustomerMessagingLanguage @default(FIL)
  revision         Int                       @default(0)
  updated_at       DateTime                  @updatedAt
}

model CustomerConversation {
  id                        String           @id @default(cuid())
  business_id               String
  channel_id                String
  channel                   MessengerChannel @relation(fields: [business_id, channel_id], references: [business_id, id], onDelete: Cascade)
  recipient_hash            String
  recipient_encrypted       String
  revision                  Int              @default(0)
  latest_inbound_at         DateTime?
  latest_inbound_message_id String?
  last_human_reply_at       DateTime?
  last_activity_at          DateTime
  takeover                  Boolean          @default(false)
  opted_out                 Boolean          @default(false)
  language_preference       CustomerMessagingLanguage?
  messages                  CustomerMessage[]
  jobs                      CustomerMessagingJob[]
  metadata_expires_at       DateTime
  created_at                DateTime         @default(now())

  @@unique([business_id, id])
  @@unique([channel_id, recipient_hash])
  @@index([business_id, last_activity_at])
  @@index([metadata_expires_at])
}

model CustomerMessage {
  id                    String                   @id @default(cuid())
  business_id           String
  conversation_id       String
  conversation          CustomerConversation     @relation(fields: [business_id, conversation_id], references: [business_id, id], onDelete: Cascade)
  provider_message_hash String                   @unique
  direction             CustomerMessageDirection
  text_encrypted        String?
  text_expires_at       DateTime
  occurred_at           DateTime
  metadata_expires_at   DateTime

  @@index([business_id, conversation_id, occurred_at])
  @@index([text_expires_at])
  @@index([metadata_expires_at])
}

model CustomerMessagingReceipt {
  id                  String           @id @default(cuid())
  business_id         String
  channel_id          String
  channel             MessengerChannel @relation(fields: [business_id, channel_id], references: [business_id, id], onDelete: Cascade)
  event_hash          String           @unique
  occurred_at         DateTime
  metadata_expires_at DateTime

  @@index([metadata_expires_at])
}

// A keyed identity fingerprint, never a name/recipient ID. Retained while the
// channel exists so deleting thirty-day conversation data cannot reset opt-out.
model CustomerMessagingSuppression {
  business_id    String
  channel_id     String
  channel        MessengerChannel @relation(fields: [business_id, channel_id], references: [business_id, id], onDelete: Cascade)
  recipient_hash String

  @@id([channel_id, recipient_hash])
}

model CustomerMessagingJob {
  id                    String                     @id @default(cuid())
  business_id           String
  conversation_id       String
  conversation          CustomerConversation       @relation(fields: [business_id, conversation_id], references: [business_id, id], onDelete: Cascade)
  revision              Int
  status                CustomerMessagingJobStatus @default(PENDING)
  due_at                DateTime
  origin_event_at       DateTime
  attempts              Int                        @default(0)
  lease_token           String?
  lease_expires_at      DateTime?
  delivery_key          String                     @unique
  provider_message_hash String?                    @unique
  draft_encrypted       String?
  draft_language        CustomerMessagingLanguage?
  text_expires_at       DateTime
  metadata_expires_at   DateTime
  reason                String?
  created_at            DateTime                   @default(now())
  updated_at            DateTime                   @updatedAt

  @@unique([business_id, conversation_id, revision])
  @@index([status, due_at])
  @@index([status, lease_expires_at])
  @@index([text_expires_at])
  @@index([metadata_expires_at])
}

model SocialPost {
  id String @id @default(cuid())

  business_id String
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  sale_event_id Int?
  sale_event    SaleEvent? @relation(fields: [sale_event_id], references: [id], onDelete: SetNull)

  source SocialPostSource
  status SocialPostStatus @default(DRAFT)

  // Wave L1: organic post category (TIPS_EDUCATION, BEHIND_THE_SCENES,
  // SEASONAL_GREETING, TEAM_SPOTLIGHT, SERVICE_SHOWCASE, GENERAL).
  // Stored as String, validated at the application boundary against
  // OrganicPostCategory in lib/services/social/caption-generator.ts —
  // same pattern as SocialPostRequest.category. Nullable for backward
  // compatibility with rows created before this column existed and for
  // sale-event posts (where category isn't applicable).
  category      String?
  title         String
  caption_draft String
  caption_final String?
  hashtags      String[] @default([])
  media_url     String?

  created_by_user_id String?
  created_by_user    User?   @relation("SocialPostCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  publish_requested_at DateTime?
  published_at         DateTime?
  last_error           String?

  targets          SocialPostTarget[]
  growth_campaigns Campaign[]
  // 1:0..1 — set when this SocialPost was approved from a request
  // (see SocialPostRequest.social_post_id @unique).
  source_request   SocialPostRequest? @relation("SocialPostFromRequest")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([business_id, status, created_at])
  @@index([sale_event_id])
}

model SocialPostTarget {
  id String @id @default(cuid())

  social_post_id String
  social_post    SocialPost @relation(fields: [social_post_id], references: [id], onDelete: Cascade)

  social_connection_id String
  social_connection    SocialConnection @relation(fields: [social_connection_id], references: [id], onDelete: Cascade)

  status SocialTargetStatus @default(SKIPPED)

  attempts         Int       @default(0)
  last_error       String?
  remote_post_id   String?
  remote_permalink String?
  published_at     DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([social_post_id, social_connection_id])
  @@index([status, attempts, created_at])
}

model User {
  id              String @id @default(cuid())
  contact_number  String @unique
  hashed_password String
  name            String

  role                                    Role                             @default(EMPLOYEE)
  employee                                Employee?
  owner                                   Owner?
  social_posts_created                    SocialPost[]                     @relation("SocialPostCreatedBy")
  growth_campaigns_created                Campaign[]                       @relation("GrowthCampaignCreatedBy")
  expenses_created                        Expense[]                        @relation("ExpenseCreatedBy")
  awarded_subscription_credits            SubscriptionCreditLedger[]       @relation("CreditAwardedByUser")
  platform_action_logs                    PlatformActionLog[]              @relation("PlatformActorUser")
  reviewed_onboarding_applications        OnboardingApplication[]          @relation("ReviewedByPlatformUser")
  submitted_subscription_upgrade_requests SubscriptionPlanUpgradeRequest[] @relation("SubscriptionUpgradeRequestedBy")
  reviewed_subscription_upgrade_requests  SubscriptionPlanUpgradeRequest[] @relation("SubscriptionUpgradeReviewedBy")
  // Booking-editor + social-post-request back-relations
  cancelled_bookings                      Booking[]                        @relation("BookingCancelledBy")
  booking_notes_created                   BookingNote[]                    @relation("BookingNoteCreatedBy")
  booking_price_adjustments_created       BookingPriceAdjustment[]         @relation("BookingPriceAdjustmentCreatedBy")
  submitted_social_post_requests          SocialPostRequest[]              @relation("SocialPostRequestRequestedBy")
  reviewed_social_post_requests           SocialPostRequest[]              @relation("SocialPostRequestReviewedBy")
  uploaded_brand_assets                   BrandAsset[]                     @relation("BrandAssetsUploadedBy")
  booking_payments_verified               BookingPayment[]                 @relation("BookingPaymentVerifiedBy")
  booking_payments_voided                 BookingPayment[]                 @relation("BookingPaymentVoidedBy")

  must_change_password     Boolean   @default(false)
  temp_password_expires_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Employee {
  id                    Int                  @id @default(autoincrement())
  user_id               String               @unique
  user                  User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  salary                Float
  commission_percentage Float                @default(0)
  daily_rate            Float                @default(0)
  employment_start      DateTime?            @db.Date
  employment_end        DateTime?            @db.Date
  archived_at           DateTime?
  financial_revision    Int                  @default(0)
  compensation_agreements CompensationAgreement[]
  payroll_profile       EmployeePayrollProfile?
  payroll_earnings       PayrollEarning[]
  payroll_statements     PayrollStatement[]
  work_sessions         WorkforceSession[]
  attendance_revisions  AttendanceRevision[]
  attendance_correction_requests AttendanceCorrectionRequest[]
  leave_entitlements    LeaveEntitlement[]
  leave_allocations     LeaveAllocation[]
  payroll_adjustments   PayrollAdjustment[]
  profile               StaffProfile         @default(STAFF)
  permissions           StaffPermission[]    @default([BOOKING_CREATE, BOOKING_MODIFY, BOOKING_CANCEL, BOOKING_MARK_NO_SHOW, BOOKING_ADJUST_PRICE, PAYMENT_COLLECT, QUEUE_CLAIM_SELF, QUEUE_SERVE_SELF])
  specialties           String[]             @default([]) // Array of service categories this employee can perform
  // Day-of-week values (0=Sunday … 6=Saturday) the employee never
  // works. Captures "Anna doesn't work Sundays" for shops that
  // don't keep a formal shift schedule. Empty array (default) =
  // available every business-open day. Honored by computeSlots()
  // for both same-day and advance bookings.
  recurring_days_off    Int[]                @default([])
  attendance            EmployeeAttendance[]
  // Optional formal weekly shift schedule. Only honored when the
  // owning Business has formal_schedule_enabled=true. Each row covers
  // one (employee, day_of_week) pair; multiple rows can model split
  // shifts on the same day if needed.
  schedule              EmployeeSchedule[]

  served_services AvailedService[]
  payslips        Payslip[]
  leave_requests  LeaveRequest[]
  brand_assets    BrandAsset[]     @relation("EmployeeBrandAssets")

  business_id String
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  // Demo-data flag — see Service.is_demo.
  is_demo Boolean @default(false)

  @@unique([business_id, user_id])
  @@unique([id, business_id])
  @@index([business_id])
  @@index([business_id, is_demo])
}

/**
 * EmployeeSchedule — optional formal weekly shift rows. Only honored
 * when the owning Business has `formal_schedule_enabled=true`. An
 * employee with zero rows falls back to the default behavior
 * (recurring_days_off + business hours) even when the flag is on, so
 * tenants can opt employees in incrementally.
 * `start_time` / `end_time` are "HH:MM" strings in the business's
 * timezone — same shape as BusinessHours, intentionally consistent.
 * Multiple rows per (employee, day_of_week) are allowed to model
 * split shifts (e.g. morning + evening with a midday break).
 * No admin UI ships in this iteration — managed via Prisma Studio or
 * a future settings screen. Schema and slot integration only.
 */
model EmployeeSchedule {
  id          Int      @id @default(autoincrement())
  employee_id Int
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  day_of_week Int // 0 = Sunday, 6 = Saturday
  start_time  String // "09:00"
  end_time    String // "17:00"

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([employee_id, day_of_week])
}

model EmployeeAttendance {
  id          Int      @id @default(autoincrement())
  employee_id Int
  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  date   DateTime
  status AttendanceStatus @default(PRESENT)

  time_in           DateTime?
  time_out          DateTime?
  location_verified Boolean   @default(false)
  latitude          Float?
  longitude         Float?

  is_paid_leave Boolean @default(false)
  payroll_confirmed_at DateTime?
  payroll_confirmed_by String?
  revision Int @default(0)

  // Once stamped, this row is locked into a payslip and will not be paid again.
  paid_in_payslip_id Int?
  paid_in_payslip    Payslip? @relation("PayslipAttendance", fields: [paid_in_payslip_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([employee_id, date])
  @@index([employee_id, status, date])
  @@index([date])
  @@index([paid_in_payslip_id])
}

