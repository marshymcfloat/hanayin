// Reusable brand-asset library per business. One row per uploaded
// image, classified by `kind`. Designed so the same library can feed:
//   - Watermarks (LOGO -> resvg overlay on social posts)
//   - Hero / cover (HERO -> social previews, public booking page)
//   - Service thumbnails (SERVICE -> service_id set)
//   - Employee avatars (EMPLOYEE -> employee_id set)
//   - AI image-gen reference photos (REFERENCE -> Gemini / OpenAI
//     image-to-image)
// kind=SERVICE / EMPLOYEE rows require the corresponding FK; other
// kinds leave them null. Enforced by app-layer validation since
// Postgres conditional NOT NULL needs CHECK constraints we'd rather
// keep loose for migration ergonomics.
model BrandAsset {
  id          String   @id @default(cuid())
  business_id String
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  kind BrandAssetKind

  // Only set for kind=REFERENCE. Drives identity-preservation vs visual-
  // direction wording in the social-post image prompt builder.
  reference_subject ReferenceSubject?

  url         String
  alt         String?
  // Storage-backend hint (blob path) for future delete-on-remove cron.
  // Stored separately from url so the public URL can be rewritten
  // (e.g. CDN swap) without losing the original key.
  storage_key String?

  service_id Int?
  service    Service? @relation("ServiceBrandAssets", fields: [service_id], references: [id], onDelete: Cascade)

  employee_id Int?
  employee    Employee? @relation("EmployeeBrandAssets", fields: [employee_id], references: [id], onDelete: Cascade)

  uploaded_by_user_id String?
  uploaded_by         User?   @relation("BrandAssetsUploadedBy", fields: [uploaded_by_user_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([business_id, kind])
  @@index([service_id])
  @@index([employee_id])
}

