  line PayrollStatementLine @relation(fields: [line_id, statement_id, business_id], references: [id, statement_id, business_id], onDelete: Restrict)
  amount Decimal @db.Decimal(18, 2)
  @@unique([payment_id, line_id])
  @@index([business_id, statement_id])
}

model PayrollPaymentReconciliation {
  id String @id @default(uuid())
  business_id String
  statement_id String
  statement PayrollStatement @relation(fields: [statement_id, business_id], references: [id, business_id], onDelete: Restrict)
  payment_date DateTime @db.Date
  amount Decimal @db.Decimal(18, 2)
  tax_delta Decimal @db.Decimal(18, 2)
  statement_revision Int
  source_hash String
  snapshot Json
  reason String
  actor_id String
  command_key String
  payment PayrollPayment?
  created_at DateTime @default(now())
  @@unique([business_id, command_key])
  @@unique([business_id, source_hash])
  @@unique([id, statement_id, business_id])
  @@index([business_id, statement_id])
}

model PayrollAdjustment {
  id String @id @default(uuid())
  business_id String
  employee_id Int
  employee Employee @relation(fields: [employee_id, business_id], references: [id, business_id], onDelete: Restrict)
  original_statement_id String?
  original_statement PayrollStatement? @relation(fields: [original_statement_id, business_id], references: [id, business_id], onDelete: Restrict)
  amount Decimal @db.Decimal(18, 2)
  code String
  label String?
  reason String
  authorization String
  effective_on DateTime @db.Date
  disposition String @default("PENDING")
  actor_id String
  revision Int @default(0)
  earning_id String?
  source_revision Int @default(0)
  created_at DateTime @default(now())
  @@index([business_id, employee_id, disposition])
  @@unique([earning_id, source_revision])
}

model PayrollCommand {
  id String @id @default(uuid())
  business_id String
  business Business @relation(fields: [business_id], references: [id], onDelete: Restrict)
  key String
  actor_id String
  operation String
  payload_hash String
  result Json
  created_at DateTime @default(now())
  @@unique([business_id, key])
}

model PayrollNotification {
  id String @id @default(uuid())
  business_id String
  statement_id String
  statement PayrollStatement @relation(fields: [statement_id, business_id], references: [id, business_id], onDelete: Restrict)
  user_id String
  read_at DateTime?
  sms_state String @default("NOT_REQUESTED")
  sms_message_id String?
  sms_attempts Int @default(0)
  sms_last_error String?
  created_at DateTime @default(now())
  @@unique([statement_id, user_id])
  @@index([business_id, user_id, read_at])
}

// Booking-editor (Phase 1) — see docs/booking-editor-design.md §8.

enum BookingNoteVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
}

model BookingNote {
  id         String                @id @default(cuid())
  booking_id Int
  booking    Booking               @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  body       String
  visibility BookingNoteVisibility @default(INTERNAL)

  created_by_user_id String?
  created_by_user    User?   @relation("BookingNoteCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())

  @@index([booking_id, created_at])
  @@index([created_by_user_id])
}

model BookingPriceAdjustment {
  id                 String          @id @default(cuid())
  booking_id         Int
  booking            Booking         @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  // Optional link to a specific service line. When null, the adjustment
  // applies to the booking as a whole (e.g. a friend-of-the-house
  // discount on the total).
  availed_service_id Int?
  availed_service    AvailedService? @relation(fields: [availed_service_id], references: [id], onDelete: SetNull)

  // Negative for discounts, positive for surcharges. Applied on top of
  // the underlying service's pricing chain.
  delta_amount Float
  reason       String

  created_by_user_id String?
  created_by_user    User?   @relation("BookingPriceAdjustmentCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())

  @@index([booking_id, created_at])
  @@index([availed_service_id])
  @@index([created_by_user_id])
}

// Social-post-request — see docs/social-post-request-design.md §3.

enum SocialPostRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model SocialPostRequest {
  id          String   @id @default(cuid())
  business_id String
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  // Submission
  requested_by_user_id String
  requested_by_user    User      @relation("SocialPostRequestRequestedBy", fields: [requested_by_user_id], references: [id], onDelete: Cascade)
  topic                String
  brief                String?
  // Stored as String, validated at the application boundary via the
  // existing OrganicPostCategory union in
  // lib/services/social/caption-generator.ts. Kept un-enumed here so we
  // can iterate categories in code without migrations.
  category             String
  // Same rationale: validated against captionToneSchema in
  // features/growth/schemas.ts. Null means "let the owner decide".
  desired_tone         String?
  attachment_url       String?
  due_date             DateTime?

  // Lifecycle
  status              SocialPostRequestStatus @default(PENDING)
  reviewed_by_user_id String?
  reviewed_by_user    User?                   @relation("SocialPostRequestReviewedBy", fields: [reviewed_by_user_id], references: [id], onDelete: SetNull)
  reviewed_at         DateTime?
  rejection_reason    String?

  // Conversion link to the SocialPost the owner approved this into.
  // Unique because each request maps to at most one SocialPost.
  social_post_id String?     @unique
  social_post    SocialPost? @relation("SocialPostFromRequest", fields: [social_post_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([business_id, status, created_at])
  @@index([requested_by_user_id])
  @@index([reviewed_by_user_id])
}

// Audit Trail: records who changed what and when
model AuditLog {
  id          String  @id @default(cuid())
  entity_type String // "Booking", "Payslip"
  entity_id   String
  action      String // "CREATED", "STATUS_CHANGED"
  actor_id    String? // User ID (nullable for system actions)
  actor_type  String  @default("USER") // "USER", "SYSTEM", "WEBHOOK"
  changes     Json? // { before: {...}, after: {...} }

  business_id String
  created_at  DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([entity_type, entity_id, action])
  @@index([business_id, created_at])
  @@index([actor_id])
}

enum ExpenseCategory {
  SUPPLIES
  UTILITIES
  RENT
  EQUIPMENT
  MARKETING
  MAINTENANCE
  PROFESSIONAL
  MISCELLANEOUS
}

model Expense {
  id          Int      @id @default(autoincrement())
  business_id String
  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  amount      Float
  category    ExpenseCategory
  description String?
  date        DateTime

  created_by_user_id String?
  created_by_user    User?   @relation("ExpenseCreatedBy", fields: [created_by_user_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([business_id, date])
  @@index([business_id, category])
  @@index([business_id, date, category])
}
