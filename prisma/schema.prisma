model Booking {
  id Int @id @default(autoincrement())
  request_key String?
  request_scope String?
  request_payload_hash String?
  pricing_snapshot Json?
  offer_applications BookingOfferApplication[]
  change_commands BookingChangeCommand[]

  status      BookingStatus @default(ACCEPTED)
  // customer_id is nullable to support anonymous walk-ins (booking with no
  // tracked customer profile). When customer_id is null, is_anonymous_walk_in
  // must be true and customer_label captures the staff-typed identifier.
  customer    Customer?     @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  customer_id String?

  // True when the booking was recorded without linking to a Customer profile.
  // The customer chose not to share contact info. Booking still counts in
  // revenue, but is excluded from customer rankings, trust tier, no-show
  // tracking, and re-engagement campaigns.
  is_anonymous_walk_in Boolean @default(false)
  // Free-text label staff typed for an anonymous walk-in (e.g. "Walk-in #3",
  // "Guy in red shirt"). Lets the booking still be identifiable in lists
  // without polluting the Customer table. Null for non-anonymous bookings.
  customer_label       String?

  business    Business @relation(fields: [business_id], references: [id], onDelete: Cascade)
  business_id String

  vouchers Voucher[]

  payment_method     PaymentMethod    @default(CASH)
  payment_status     PaymentStatus    @default(UNPAID)
  amount_paid        Float            @default(0)
  availed_services   AvailedService[]
  payments           BookingPayment[]
  grand_total        Float
  total_discount     Float
  downpayment        Float?
  downpayment_status BookingStatus?   @default(ACCEPTED)
  downpayment_date   DateTime?

  // Scheduling fields
  scheduled_at                  DateTime? // When the booking is scheduled to start
  estimated_end                 DateTime? // Calculated from service durations
  reminder_sent                 Boolean   @default(false)
  reminder_sent_at              DateTime?
  reminder_message_id           String?
  reminder_last_error           String?
  reminder_attempts             Int       @default(0)
  confirmation_sms_attempted_at DateTime?
  confirmation_sms_sent_at      DateTime?
  confirmation_sms_message_id   String?
  confirmation_sms_last_error   String?
  hold_expires_at               DateTime? // Legacy: was used for QRPH payment hold
  capacity_override_applied     Boolean   @default(false)
  capacity_override_reason      String?
  capacity_override_note        String?

  sale_event_id Int?
  sale_event    SaleEvent? @relation(fields: [sale_event_id], references: [id], onDelete: SetNull)

  // Computed columns for double-booking prevention (maintained by DB triggers)
  /// @ignore - Managed by database triggers, do not write directly
  booking_range     String?  @ignore
  /// @ignore - Managed by database triggers, do not write directly
  is_active_booking Boolean? @ignore

  // Soft-cancel (Booking-editor Phase 1). Distinct from status =
  // CANCELLED so we can support a 24h "undo" window before scrubbing.
  cancelled_at        DateTime?
  cancelled_by_id     String?
  cancelled_by        User?     @relation("BookingCancelledBy", fields: [cancelled_by_id], references: [id], onDelete: SetNull)
  cancellation_reason String?

  // Customer self-serve audit (tokenized cancel/reschedule pages).
  // `cancelled_by_customer` flags self-serve cancellations so staff
  // dashboards can render a different pill ("Cancelled by customer")
  // without joining BookingCustomer. `rescheduled_at` + count let
  // staff see at a glance which bookings have been moved post-creation.
  cancelled_by_customer Boolean   @default(false)
  rescheduled_at        DateTime?
  reschedule_count      Int       @default(0)

  notes             BookingNote[]
  price_adjustments BookingPriceAdjustment[]

  // Demo-data flag — see Service.is_demo.
  is_demo Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([business_id, status])
  @@unique([business_id, request_scope, request_key])
  @@index([business_id, scheduled_at])
  @@index([business_id, created_at])
  @@index([customer_id, business_id, scheduled_at])
  @@index([status, hold_expires_at])
  @@index([business_id, is_demo])
  @@index([status, reminder_sent, scheduled_at])
  @@index([sale_event_id, status])
  @@index([customer_id])
  @@index([created_at])
  @@index([scheduled_at])
  @@index([business_id, is_anonymous_walk_in])
  @@index([cancelled_by_id])
}

