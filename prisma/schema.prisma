model GiftCard {
  id Int @id @default(autoincrement())

  code           String   @unique
  customer_name  String
  // Wave N4: phone added for SMS delivery. Email becomes optional in
  // application logic — at least one of {email, phone} must be present
  // so the code can actually reach the customer. Phone is also nullable
  // here for backfill compatibility with rows created before this change.
  customer_email String?
  customer_phone String?
  expires_at     DateTime

