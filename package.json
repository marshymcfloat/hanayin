{
  "name": "service-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "test:ci": "vitest run --coverage",
    "test:e2e:core": "playwright test test/e2e/platform-admin-smoke.spec.ts test/e2e/private-routes-smoke.spec.ts test/e2e/owner-growth-flow.spec.ts",
    "test:e2e:db": "playwright test test/e2e/public-booking-smoke.spec.ts",
    "test:e2e": "node scripts/require-env.mjs DIRECT_DATABASE_URL && npm run test:e2e:core && npm run test:e2e:db",
    "build:app": "next build",
    "build:release": "node scripts/require-env.mjs DATABASE_URL && node scripts/prisma-migrate-deploy-safe.mjs && npm run build:app",
    "build": "npm run build:release",
    "build:prod": "npm run build:release",
    "verify:release": "npm run lint && npm run typecheck && npm run test:ci && npm run test:e2e && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
