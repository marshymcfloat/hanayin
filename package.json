{
  "name": "service-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:unit": "vitest run --coverage",
    "test:ci": "npm run test:unit",
    "test:integration": "node scripts/run-database-tests.mjs integration",
    "test:e2e:core": "playwright test test/e2e/platform-admin-smoke.spec.ts test/e2e/private-routes-smoke.spec.ts test/e2e/owner-growth-flow.spec.ts",
    "test:e2e:db": "node scripts/run-database-tests.mjs db",
    "test:e2e": "node scripts/run-database-tests.mjs all",
    "build:app": "next build",
    "build:release": "node scripts/require-env.mjs --command build:release DATABASE_URL DIRECT_DATABASE_URL && node scripts/require-env.mjs --command build:release --direct-postgres DIRECT_DATABASE_URL && node scripts/prisma-migrate-deploy-safe.mjs && npm run build:app",
    "build": "npm run build:release",
    "build:prod": "npm run build:release",
    "check": "npm run lint -- --max-warnings=0 && npm run typecheck && npm run check:boundaries && npm run test:unit && npm run build:app",
    "check:push": "npm run check",
    "verify:release": "npm run check && npm run test:integration && npm run test:e2e && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
